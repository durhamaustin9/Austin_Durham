# Public values are embedded in the browser bundle during `next build`.
NEXT_PUBLIC_SITE_URL=https://austindurham.info
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://b.austindurham.info
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# Server logs go directly to PostHog's regional OTLP collector, not the browser proxy.
POSTHOG_LOGS_HOST=https://us.i.posthog.com
